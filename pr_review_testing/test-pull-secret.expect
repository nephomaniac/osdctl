#!/usr/bin/expect -f
#
# Test harness for osdctl cluster pull-secret commands.
# Runs commands, feeds stdin responses to prompts, captures stdout to log files.
# Does NOT evaluate output — an AI reads the logs to assess results.
#
# Usage:
#   expect test-pull-secret.expect <hcp-cluster-id> [classic-cluster-id] [hive-ocm-url] [options]
#
# Options:
#   --mutate              Enable mutating tests (tamper + fix pull secrets)
#   --osdctl-bin <path>   Path to osdctl binary (default: ../osdctl)
#   --reason <string>     Elevation reason string (default: ROSAENG-2057)
#   --account-id <id>     Account ID for audit test (default: auto-derived from HCP cluster)
#
# Examples:
#   expect test-pull-secret.expect <your-hcp-cluster-id>
#   expect test-pull-secret.expect <your-hcp-cluster-id> <your-classic-cluster-id> prod --mutate
#   expect test-pull-secret.expect <your-hcp-cluster-id> --osdctl-bin /path/to/osdctl --reason OHSS-1234
#
# Output:
#   All test output is written to $tmpdir/testNN.log files.
#   After the run, review the logs:
#     cat $tmpdir/test*.log
#   Or have an AI review them for correctness and improvements.
#
# AI REVIEW DIRECTIVE — SUMMARY TABLE:
#   After reviewing all log files, produce a summary table with these columns:
#     Test # | Name | Log File | Result (PASS/FAIL/SKIP) | Notes
#   For each test, use the per-test PASS/FAIL criteria in the section directives below.
#   A test PASSES if its log output matches the PASS criteria. It FAILS if it matches
#   any FAIL criteria or shows unexpected errors/panics/stack traces.
#   After the table, list:
#     1. "What was tested" — summarize the coverage (command structure, validation,
#        dry-run flows, live mutations, OAO reconciliation, etc.)
#     2. "What was NOT tested" — note these gaps:
#        - Production OCM environment (all tests use staging)
#        - Concurrent tool execution by multiple SREs
#        - Clusters with custom/additional pull secret registries beyond the standard 4
#        - Network failures or OCM API outages mid-operation
#        - Clusters with aggressive MachineHealthCheck thresholds
#        - Cross-organization ownership scenarios
#     3. "Cluster health" — after mutating tests, verify the cluster is still healthy:
#        - Run: oc get clusteroperators — all should be Available=True, Degraded=False
#        - Run: oc get nodes — all should be Ready, no recent restarts
#        - Run: oc get pods -n openshift-image-registry — pods Running, no CrashLoopBackOff
#        - Run: oc get pods -n openshift-config — no issues
#        - Run: oc get pods -n openshift-monitoring -l app.kubernetes.io/name=telemeter-client — Running
#        - Run: oc get pods -n openshift-ocm-agent-operator -l app=ocm-agent — Running, low restart count
#        - Check: kubelet Ready transition times unchanged from pre-test baseline
#        - Check: no new MachineHealthCheck remediations triggered
#        If any cluster operator is degraded or image-registry pods are failing after
#        pull secret rotation, this indicates the new pull secret may be invalid or
#        the rotation disrupted cluster components — flag as a FAIL.
#     4. Any findings — unexpected output, warnings worth investigating, or
#        behavioral differences from what the directives describe.

set timeout 300

# --- Argument parsing: extract --flag value pairs, collect positional args ---
set osdctl_bin "../osdctl"
set reason "ROSAENG-2057"
set account_id_override ""
set run_mutate 0
set positional_args {}

set i 0
while {$i < [llength $argv]} {
    set arg [lindex $argv $i]
    switch -- $arg {
        "--mutate" {
            set run_mutate 1
        }
        "--osdctl-bin" {
            incr i
            set osdctl_bin [lindex $argv $i]
        }
        "--reason" {
            incr i
            set reason [lindex $argv $i]
        }
        "--account-id" {
            incr i
            set account_id_override [lindex $argv $i]
        }
        default {
            lappend positional_args $arg
        }
    }
    incr i
}

set hcp_cluster_id [lindex $positional_args 0]
set classic_cluster_id [lindex $positional_args 1]
set hive_ocm_url [lindex $positional_args 2]

if {$hcp_cluster_id eq ""} {
    puts "Usage: expect test-pull-secret.expect <hcp-cluster-id> \[classic-cluster-id\] \[hive-ocm-url\] \[options\]"
    puts ""
    puts "Positional arguments:"
    puts "  hcp-cluster-id      HCP cluster ID (required)"
    puts "  classic-cluster-id  Classic cluster ID (optional — enables Classic tests)"
    puts "  hive-ocm-url        OCM environment for Hive (e.g. 'prod' — required for Classic)"
    puts ""
    puts "Options:"
    puts "  --mutate              Enable mutating tests (tamper + fix pull secrets)"
    puts "  --osdctl-bin <path>   Path to osdctl binary (default: ../osdctl)"
    puts "  --reason <string>     Elevation reason string (default: ROSAENG-2057)"
    puts "  --account-id <id>     Account ID for audit test (default: auto-derived from cluster)"
    exit 1
}

# Verify binary exists
if {![file executable $osdctl_bin]} {
    puts "ERROR: osdctl binary not found or not executable at '$osdctl_bin'"
    puts "Build with: cd .. && go build -o osdctl ."
    puts "Or pass --osdctl-bin /path/to/osdctl"
    exit 1
}

# Export reason so test-ps-helpers.sh picks it up
set env(TEST_REASON) $reason

set tmpdir [exec mktemp -d /tmp/pull-secret-test.XXXXXX]
puts "============================================================"
puts "Pull Secret Test Harness"
puts "HCP Cluster:     $hcp_cluster_id"
if {$classic_cluster_id ne ""} {
    puts "Classic Cluster:  $classic_cluster_id"
}
if {$hive_ocm_url ne ""} {
    puts "Hive OCM URL:     $hive_ocm_url"
}
if {$run_mutate} {
    puts "Mode:             READ-ONLY + MUTATING"
} else {
    puts "Mode:             READ-ONLY"
}
puts "Binary:           $osdctl_bin"
puts "Output:           $tmpdir"
puts "============================================================"

set test_count 0

# --- run_cmd: spawn a command, feed responses to prompts, log stdout ---
proc run_cmd {outfile cmd {responses {}}} {
    eval spawn {*}$cmd
    log_file -noappend $outfile
    foreach resp $responses {
        expect {
            -re "Continue\\? \\(y/N\\):" { send "$resp\r" }
            "Type YES to confirm:" { send "$resp\r" }
            timeout { break }
            eof {
                log_file
                catch {wait}
                return
            }
        }
    }
    expect {
        eof {}
        timeout {}
    }
    log_file
    catch {wait}
}

proc test_label {name} {
    upvar test_count tc
    incr tc
    puts "  \[$tc\] $name"
}

# --- Shell helper for mutating ops ---
set helpers [file join [file dirname [info script]] "test-ps-helpers.sh"]

proc bp_login {cluster_id} {
    upvar helpers h
    for {set attempt 1} {$attempt <= 3} {incr attempt} {
        if {[catch {exec bash $h login $cluster_id 2>@1} result]} {
            if {[string match "*429*" $result] || [string match "*Rate limit*" $result]} {
                puts "    (rate limited, retry $attempt/3 in 30s...)"
                after 30000
                continue
            }
            error $result
        }
        return
    }
    error "backplane login failed after 3 retries"
}
proc bp_logout {} {
    upvar helpers h
    catch {exec bash $h logout 2>@1}
}
proc tamper_email {registry new_email} {
    upvar helpers h
    exec bash $h tamper-email $registry $new_email 2>@1
}
proc tamper_token {registry new_token} {
    upvar helpers h
    exec bash $h tamper-token $registry $new_token 2>@1
}
proc add_fake_auth {registry token email} {
    upvar helpers h
    exec bash $h add-auth $registry $token $email 2>@1
}
proc remove_fake_auth {registry} {
    upvar helpers h
    exec bash $h remove-auth $registry 2>@1
}

set mreason "${reason}-mutating"

# ============================================================
# SECTION 1: Help and command structure
#
# REVIEW DIRECTIVES:
#   What: Verifies command tree, subcommand help text, and deprecation messages
#   PASS: Each command prints help/usage text without errors
#   FAIL: Missing subcommands, broken help, panics, or missing deprecation warnings
#   Per-test criteria:
#   - test01-04: Subcommands (audit, update, validate) listed under pull-secret
#   - test02: update help shows --cluster-id, --reason (required), --dry-run, --force, --hive-ocm-url (optional)
#   - test02: update help has "Required Flags" and "Optional Flags" sections (not default "Flags:")
#   - test03: audit help shows --cluster-id OR --account-id, --reason, --validate
#   - test04: validate help wraps validate-pull-secret-ext
#   - test05-06: Deprecated commands show deprecation warning AND still display help
#   - test07: Original validate-pull-secret is NOT deprecated
# ============================================================
puts "\n--- Section 1: Help and command structure ---"

test_label "pull-secret parent help"
run_cmd "$tmpdir/test01.log" [list $osdctl_bin -S cluster pull-secret --help]

test_label "pull-secret update help"
run_cmd "$tmpdir/test02.log" [list $osdctl_bin -S cluster pull-secret update --help]

test_label "pull-secret audit help"
run_cmd "$tmpdir/test03.log" [list $osdctl_bin -S cluster pull-secret audit --help]

test_label "pull-secret validate help"
run_cmd "$tmpdir/test04.log" [list $osdctl_bin -S cluster pull-secret validate --help]

test_label "deprecated replace-pull-secret"
run_cmd "$tmpdir/test05.log" [list $osdctl_bin -S cluster replace-pull-secret --help]

test_label "deprecated validate-pull-secret-ext"
run_cmd "$tmpdir/test06.log" [list $osdctl_bin -S cluster validate-pull-secret-ext --help]

test_label "validate-pull-secret (original, not deprecated)"
run_cmd "$tmpdir/test07.log" [list $osdctl_bin -S cluster validate-pull-secret --help]

# ============================================================
# SECTION 2: Input validation and error handling
#
# REVIEW DIRECTIVES:
#   What: Verifies required flags, bad input rejection, and injection prevention
#   PASS: Each invalid input produces a specific error message (not a panic or stack trace)
#   FAIL: Missing validation, generic errors, panics, or commands that proceed with bad input
#   Per-test criteria:
#   - test08: No flags → "required flag" error mentioning both --cluster-id and --reason
#   - test09: Missing reason → "required flag" mentioning "reason"
#   - test10: Missing cluster-id → "required flag" mentioning "cluster"
#   - test08-10: Must NOT show full help text (SilenceUsage should be set)
#   - test11-12: Audit with no flags → custom "one of --cluster-id or --account-id" error
#   - test13: Invalid --hive-ocm-url → "invalid --hive-ocm-url" with valid alias list
#   - test14: Bad reason → warns about missing ticket ID, aborts on "n"
#   - test15: Bogus cluster ID → cluster-not-found error, NOT a panic or stack trace
#   - test15b: Both --cluster-id and --account-id → "mutually exclusive" error
#   - test15c: Special characters in --account-id → "invalid characters" error
# ============================================================
puts "\n--- Section 2: Input validation ---"

test_label "update with no flags"
run_cmd "$tmpdir/test08.log" [list $osdctl_bin -S cluster pull-secret update]

test_label "update missing reason"
run_cmd "$tmpdir/test09.log" [list $osdctl_bin -S cluster pull-secret update -C test123]

test_label "update missing cluster-id"
run_cmd "$tmpdir/test10.log" [list $osdctl_bin -S cluster pull-secret update --reason test]

test_label "audit with no flags"
run_cmd "$tmpdir/test11.log" [list $osdctl_bin -S cluster pull-secret audit]

test_label "audit missing both --cluster-id and --account-id"
run_cmd "$tmpdir/test12.log" [list $osdctl_bin -S cluster pull-secret audit --reason test]

test_label "invalid --hive-ocm-url"
run_cmd "$tmpdir/test13.log" [list $osdctl_bin -S cluster pull-secret update -C test --reason test --hive-ocm-url invalid-env]

test_label "bad reason (no ticket ID)"
run_cmd "$tmpdir/test14.log" [list $osdctl_bin -S cluster pull-secret update -C $hcp_cluster_id --reason "no-ticket-here" --dry-run] {n}

test_label "bogus cluster ID"
run_cmd "$tmpdir/test15.log" [list $osdctl_bin -S cluster pull-secret update -C bogus-cluster-id-12345 --reason $reason --dry-run] {}

test_label "audit with both --cluster-id and --account-id (mutually exclusive)"
run_cmd "$tmpdir/test15b.log" [list $osdctl_bin -S cluster pull-secret audit -C test123 -A test456 --reason test]

test_label "audit with special characters in --account-id"
run_cmd "$tmpdir/test15c.log" [list $osdctl_bin -S cluster pull-secret audit -A {abc@inject} --reason test]

# ============================================================
# SECTION 3: HCP dry-run
#
# REVIEW DIRECTIVES:
#   What: Runs pull-secret update --dry-run against a live HCP cluster
#   PASS: Connects to mgmt/svc clusters, compares all auths, all [OK], RBAC checks pass, no mutations
#   FAIL: Connection errors, missing registries, RBAC denied, or any mutation without [Dry Run] prefix
#
#   test16 (full flow):
#   - Step 1 banner: cluster name/ID, Type=HCP, Owner, Reason, Mode=DRY-RUN
#   - [NOTE] about sibling clusters with audit hint
#   - Connects to management and service clusters
#   - Step 2: ManifestWork HCP architecture (3 layers), "Would:" prefix, RBAC can-i checks
#   - Step 3: ACCESS TOKEN + REGISTRY CREDENTIAL auths, each registry token=match email=match
#   - Result: no-op if all match. NO SyncSet/Hive/pod rollout steps (Classic only)
#
#   test17 (cancel): Shows cluster banner, "operation aborted" on 'n', no Step 2+
#   test18 (--hive-ocm-url prod): Accepted without error, ignored for HCP
#   test19 (--force): On live runs, --force skips the cluster confirmation prompt.
#     On dry-runs, the prompt may still appear (expect feeds "y" as fallback).
#     Output should be functionally identical to test16 — this tests that --force
#     is accepted without error, not that it changes dry-run behavior.
# ============================================================
puts "\n--- Section 3: HCP dry-run ---"

test_label "HCP dry-run full flow"
set cmd [list $osdctl_bin -S cluster pull-secret update -C $hcp_cluster_id --reason $reason --dry-run]
run_cmd "$tmpdir/test16.log" $cmd {y}

test_label "HCP cancel at cluster confirmation"
run_cmd "$tmpdir/test17.log" [list $osdctl_bin -S cluster pull-secret update -C $hcp_cluster_id --reason $reason --dry-run] {n}

test_label "HCP dry-run with --hive-ocm-url prod"
run_cmd "$tmpdir/test18.log" [list $osdctl_bin -S cluster pull-secret update -C $hcp_cluster_id --reason $reason --hive-ocm-url prod --dry-run] {y}

test_label "HCP dry-run with --force"
run_cmd "$tmpdir/test19.log" [list $osdctl_bin -S cluster pull-secret update -C $hcp_cluster_id --reason $reason --force --dry-run] {y}

# ============================================================
# SECTION 4: Audit command
#
# REVIEW DIRECTIVES:
#   What: Runs pull-secret audit with and without --validate against live cluster
#   PASS: Lists all clusters for account, auth tables show all [OK], correct cluster count
#   FAIL: Missing clusters, mismatched auths, connection errors, wrong cluster count
#
#   test20 (overview): Owner/Email/timestamp, cluster list with PS STATUS, cluster count,
#     "Use --validate" hint
#   test21 (--validate): ACCESS TOKEN + REGISTRY CREDENTIAL tables per cluster,
#     each registry [OK] or [!], "N validated" count, PS STATUS shown for every cluster
#   test22 (--account-id): Same format but using account ID directly instead of cluster ID
# ============================================================
puts "\n--- Section 4: Audit command ---"

test_label "audit overview (no --validate)"
run_cmd "$tmpdir/test20.log" [list $osdctl_bin -S cluster pull-secret audit -C $hcp_cluster_id --reason $reason]

test_label "audit with --validate"
run_cmd "$tmpdir/test21.log" [list $osdctl_bin -S cluster pull-secret audit -C $hcp_cluster_id --reason $reason --validate] {y}

# Auto-derive account ID from HCP cluster if not provided
if {$account_id_override eq ""} {
    puts "  Deriving account ID from HCP cluster owner..."
    if {[catch {set account_id_override [exec bash -c "ocm get /api/clusters_mgmt/v1/clusters/$hcp_cluster_id 2>/dev/null | jq -r '.subscription.creator.id // empty'"]} err]} {
        puts "  WARNING: Could not auto-derive account ID: $err"
        puts "  Set TEST_ACCOUNT_ID env var to enable audit --account-id test."
    }
    if {$account_id_override eq ""} {
        if {[catch {set account_id_override [exec bash -c "ocm get /api/accounts_mgmt/v1/current_account 2>/dev/null | jq -r '.id // empty'"]} err]} {
            puts "  WARNING: Could not get current account ID: $err"
        }
    }
}

if {$account_id_override ne ""} {
    test_label "audit with --account-id"
    run_cmd "$tmpdir/test22.log" [list $osdctl_bin -S cluster pull-secret audit -A $account_id_override --reason $reason]
} else {
    puts "  \[SKIP\] audit with --account-id (no account ID available)"
}

# ============================================================
# SECTION 5: Classic cluster dry-run
#
# REVIEW DIRECTIVES:
#   What: Runs pull-secret update --dry-run against a live Classic cluster via Hive
#   PASS: Resolves hive cluster, finds ClusterDeployment, three-way comparison (OCM/Hive/Target),
#         RBAC checks pass for secrets+syncsets+clustersync+pods, no mutations
#   FAIL: Hive resolution failure, RBAC denied, missing namespace, any mutation without [Dry Run]
#
#   test23 (full flow): Type=Classic, hive OCM connection, ClusterDeployment found,
#     "Would:" prefix for hive ops, RBAC can-i for secrets/syncsets/clustersync,
#     pod rollout RBAC for telemeter-client + ocm-agent, auth verification
#   test24 (cancel): "operation aborted" on 'n', no mutations
#   test25 (no --hive-ocm-url): Should show helpful "--hive-ocm-url" hint if hive not found
#   test26-27 (audit): Same format as HCP audit but for Classic cluster
# ============================================================
if {$classic_cluster_id ne "" && $hive_ocm_url ne ""} {
    puts "\n--- Section 5: Classic cluster dry-run ---"

    test_label "Classic dry-run full flow"
    run_cmd "$tmpdir/test23.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $reason --dry-run --hive-ocm-url $hive_ocm_url] {y}

    test_label "Classic cancel at cluster confirmation"
    run_cmd "$tmpdir/test24.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $reason --dry-run --hive-ocm-url $hive_ocm_url] {n}

    test_label "Classic dry-run without --hive-ocm-url"
    run_cmd "$tmpdir/test25.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $reason --dry-run] {y}

    test_label "Classic audit overview"
    run_cmd "$tmpdir/test26.log" [list $osdctl_bin -S cluster pull-secret audit -C $classic_cluster_id --reason $reason]

    test_label "Classic audit with --validate"
    run_cmd "$tmpdir/test27.log" [list $osdctl_bin -S cluster pull-secret audit -C $classic_cluster_id --reason $reason --validate] {y}
} else {
    puts "\n--- Section 5: Classic cluster tests SKIPPED ---"
}

# ============================================================
# MUTATING TESTS — only with --mutate flag
#
# These tests modify pull secrets on the target clusters.
# Resources touched:
#   HCP:     openshift-config/pull-secret is managed by HCCO and reverts
#            instantly, so HCP tests exercise the live update path only
#   Classic: openshift-config/pull-secret on target,
#            pull secret + SyncSets in hive namespace for this cluster ONLY
# ============================================================
if {$run_mutate} {

    puts "\n  Waiting 15s for backplane rate limit cooldown..."
    after 15000

    # ============================================================
    # SECTION M1: HCP live update
    #
    # REVIEW DIRECTIVES:
    #   What: Runs live update on an in-sync HCP cluster, captures node state before/after
    #   PASS: No-op or successful ManifestWork update, all auths match, node state unchanged
    #   FAIL: Errors, node restarts, kubelet disruption, or ManifestWork timeout without recovery
    #
    #   testM0-hcp-pre/post: Node status, kubelet Ready times, MHC state — compare for stability
    #   testM1: Live update — detects all match (no-op) or updates ManifestWork successfully
    #     If update: polls for "Applied" condition, verification shows all match
    #
    #   NOTE: On HCP, HCCO reverts direct edits to openshift-config/pull-secret
    #   within milliseconds. We cannot tamper the target PS. These tests
    #   verify the live update path works end-to-end via ManifestWork.
    # ============================================================
    # Pre-mutating node state capture
    test_label "Pre-mutating HCP node state"
    bp_login $hcp_cluster_id
    run_cmd "$tmpdir/testM0-hcp-pre.log" [list bash $helpers node-state]
    bp_logout

    puts "\n--- Section M1: HCP live update ---"

    test_label "HCP live update (in-sync cluster)"
    run_cmd "$tmpdir/testM1.log" [list $osdctl_bin -S cluster pull-secret update -C $hcp_cluster_id --reason $mreason] {y y y y y}

    after 5000
    test_label "Post-mutating HCP node state"
    bp_login $hcp_cluster_id
    run_cmd "$tmpdir/testM1-hcp-post.log" [list bash $helpers node-state]
    bp_logout

    # ============================================================
    # SECTION M2: Classic mutating tests
    #
    # REVIEW DIRECTIVES:
    #   What: Tampers pull secret registries on Classic, tests detection and repair via Hive SyncSet
    #   PASS: Tool detects tampered entries, repairs via SyncSet, final audit shows all [OK]
    #   FAIL: Tamper not detected, SyncSet stuck/orphaned, pods not restarted, auths still differ
    #
    #   testM2 (tamper+fix): Tampers cloud.openshift.com email → tool detects DIFFERS in
    #     three-way table → SyncSet created+synced+deleted → pods restarted → all match
    #   testM3 (dry-run detect): Tampers registry.redhat.io email → dry-run shows DIFFERS
    #     but makes NO changes (no "Sync completed", all lines have [Dry Run] prefix)
    #   testM3-cleanup: Live update restores the tampered email
    #   testM4 (no-op): All in sync → "nothing to update", no SyncSet created
    #
    #   State captures (compare pre vs post for stability):
    #   - testM0-classic-pre/post: node status, kubelet Ready times, MHC
    #   - testM0-oao-pre/post: OAO pod status, Secret resourceVersions, token hashes
    #
    #   testM5-verify (final audit): All clusters show [OK] for all registries.
    #     Any [!] or MISMATCH indicates incomplete cleanup — flag as FAIL.
    #
    #   CLUSTER HEALTH CHECK: After all mutations, the AI reviewer should run:
    #     oc get clusteroperators — all Available=True, Degraded=False
    #     oc get nodes — all Ready, no recent restarts since test start
    #     oc get pods -n openshift-image-registry — Running, no CrashLoopBackOff
    #     oc get pods -n openshift-monitoring -l app.kubernetes.io/name=telemeter-client — Running
    #     oc get pods -n openshift-ocm-agent-operator -l app=ocm-agent — Running
    #   If any cluster operator is degraded or image-registry is failing after
    #   pull secret rotation, flag as FAIL — the rotation may have broken image pulls.
    # ============================================================
    if {$classic_cluster_id ne "" && $hive_ocm_url ne ""} {
        puts "\n--- Section M2: Classic mutating tests ---"

        after 3000
        test_label "Pre-mutating Classic node state"
        bp_login $classic_cluster_id
        run_cmd "$tmpdir/testM0-classic-pre.log" [list bash $helpers node-state]

        test_label "Pre-mutating Classic OAO state"
        run_cmd "$tmpdir/testM0-oao-pre.log" [list bash $helpers oao-state]
        bp_logout

        after 3000
        test_label "Classic tamper email + live update fix"
        bp_login $classic_cluster_id
        tamper_email "cloud.openshift.com" "m2-tamper@test.com"
        bp_logout
        run_cmd "$tmpdir/testM2.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $mreason --hive-ocm-url $hive_ocm_url] {y y y y y}

        after 5000
        test_label "Post-mutating Classic node state"
        bp_login $classic_cluster_id
        run_cmd "$tmpdir/testM2-classic-post.log" [list bash $helpers node-state]

        test_label "Post-mutating Classic OAO state"
        run_cmd "$tmpdir/testM2-oao-post.log" [list bash $helpers oao-state]
        bp_logout

        after 3000
        test_label "Classic dry-run detects tampered email"
        bp_login $classic_cluster_id
        tamper_email "registry.redhat.io" "m3-dryrun@test.com"
        bp_logout
        run_cmd "$tmpdir/testM3.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $mreason --hive-ocm-url $hive_ocm_url --dry-run] {y}

        after 3000
        test_label "Classic cleanup tampered email"
        run_cmd "$tmpdir/testM3-cleanup.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $mreason --hive-ocm-url $hive_ocm_url] {y y y y y}

        after 5000
        test_label "Post-cleanup Classic OAO state"
        bp_login $classic_cluster_id
        run_cmd "$tmpdir/testM3-cleanup-oao-post.log" [list bash $helpers oao-state]
        bp_logout

        after 3000
        test_label "Classic no-op (all in sync)"
        run_cmd "$tmpdir/testM4.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $mreason --hive-ocm-url $hive_ocm_url] {y y}

        # ============================================================
        # OAO token reconciliation test — full two-cycle verification
        #
        # REVIEW DIRECTIVES:
        #   What: Tampers the auth TOKEN (not email), verifies OAO reconciles, then
        #         runs pull-secret update to restore the real token and verifies second reconcile
        #   PASS: OAO reconciles within ~5 min (token_hash changes, pods restart),
        #         tool restores real token, second reconcile confirms, final token_hash matches baseline
        #   FAIL: OAO does not reconcile within 6 min, token_hash unchanged, pod restarts abnormal,
        #         or final token_hash does not match pre-test baseline
        #
        #   Cycle 1 (tamper → OAO detects):
        #     testM-oao-token-pre: baseline state + token_hash
        #     Tamper: cloud.openshift.com auth → "ZmFrZXRva2Vu" (base64 "faketoken")
        #     testM-oao-wait1: polls resourceVersion every 15s → "OAO RECONCILED at Ns"
        #     testM-oao-token-mid: token_hash differs from pre, pod start times newer
        #
        #   Cycle 2 (tool restores real token):
        #     testM-oao-token: detects DIFFERS, writes real token, monitors OAO ~6 min
        #     testM-oao-token-post: token_hash matches pre-test baseline (restored)
        #
        #   OAO architecture context:
        #   - Reconciles every ~5 min (polls, cannot watch openshift-config/pull-secret)
        #   - Extracts ONLY cloud.openshift.com "auth" field (not email)
        #   - If token changed: updates ocm-access-token Secret + restarts pods
        #   - ocm-agent reads token at startup only — pod restart required for new token
        # ============================================================

        after 3000
        test_label "OAO test: capture baseline"
        bp_login $classic_cluster_id
        run_cmd "$tmpdir/testM-oao-token-pre.log" [list bash $helpers oao-state]

        test_label "OAO test: tamper auth TOKEN to fake value"
        tamper_token "cloud.openshift.com" "ZmFrZXRva2Vu"

        test_label "OAO test: get pre-tamper Secret resourceVersion"
        set oao_pre_rv [exec bash -c "ocm backplane elevate '$mreason' -- get secret ocm-access-token -n openshift-ocm-agent-operator -o 'jsonpath={.metadata.resourceVersion}' 2>/dev/null"]
        puts "    Pre-tamper resourceVersion: $oao_pre_rv"
        bp_logout

        test_label "OAO test: wait for OAO to reconcile tampered token (up to 6 min)"
        bp_login $classic_cluster_id
        run_cmd "$tmpdir/testM-oao-wait1.log" [list bash $helpers wait-for-oao-reconcile $oao_pre_rv 360]

        test_label "OAO test: capture state after first OAO reconcile"
        run_cmd "$tmpdir/testM-oao-token-mid.log" [list bash $helpers oao-state]
        bp_logout

        after 3000
        test_label "OAO test: run pull-secret update to restore real token"
        run_cmd "$tmpdir/testM-oao-token.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $mreason --hive-ocm-url $hive_ocm_url] {y y y y y}

        after 5000
        test_label "OAO test: capture final state"
        bp_login $classic_cluster_id
        run_cmd "$tmpdir/testM-oao-token-post.log" [list bash $helpers oao-state]
        bp_logout

        # ============================================================
        # --force no-op override test
        #
        # REVIEW DIRECTIVES:
        #   What: Runs live update with --force on an in-sync cluster
        #   PASS: Tool detects all sources in sync, shows "--force specified" warning,
        #         prompts "Type YES to confirm", proceeds with update, completes successfully
        #   FAIL: Tool does not prompt for YES confirmation, or proceeds without --force warning,
        #         or errors out despite --force
        # ============================================================
        after 3000
        test_label "Classic --force on in-sync cluster (no-op override)"
        run_cmd "$tmpdir/testM6-force.log" [list $osdctl_bin -S cluster pull-secret update -C $classic_cluster_id --reason $mreason --hive-ocm-url $hive_ocm_url --force] {y YES y y y y y}

        after 3000
        test_label "Post-mutating audit --validate"
        run_cmd "$tmpdir/testM5-verify.log" [list $osdctl_bin -S cluster pull-secret audit -C $classic_cluster_id --reason $mreason --validate] {y}
    } else {
        puts "\n--- Section M2: Classic mutating tests SKIPPED ---"
    }

} else {
    puts "\n--- Mutating tests SKIPPED (pass --mutate to enable) ---"
}

# ============================================================
# Summary
# ============================================================
puts "\n============================================================"
puts "Harness complete: $test_count tests captured"
puts "Output: $tmpdir"
puts ""
puts "To review all output:"
puts "  for f in $tmpdir/test*.log; do echo \"=== \$f ===\"; cat \$f; echo; done"
puts "============================================================"

exit 0
